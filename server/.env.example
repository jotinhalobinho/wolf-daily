# Porta em que o servidor vai rodar
PORT=4000

# Conexão com o banco MySQL/MariaDB (obrigatório)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rateio_horas

# Opcional: defina uma chave fixa para assinar os logins (JWT).
# Se não definir, uma chave aleatória é gerada automaticamente na primeira execução
# e salva em server/data/.jwt-secret — funciona sem configurar nada.
# JWT_SECRET=

# Opcional: só necessário se for rodar o frontend separado do backend (ex: npm run dev)
# CORS_ORIGIN=http://localhost:5173
